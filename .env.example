# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Prisma Database (Port 6543 for transaction pooling on Vercel)
# Connect to Supabase via connection pooling with custom limit=1 for serverless
DATABASE_URL="postgres://postgres.xxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Prisma Direct connection (Port 5432 for migrations)
DIRECT_URL="postgres://postgres.xxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
